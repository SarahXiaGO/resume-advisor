# Copy this file to .env and fill in real values. NEVER commit .env (it's gitignored).

# --- Frontend (Create React App) ---
# These are read by the browser bundle, so they must be prefixed with REACT_APP_.
# CRA only reads env vars at `npm start`/`npm run build` time — restart after editing.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: override the backend URL the frontend talks to (defaults to http://localhost:3001)
# REACT_APP_SERVER_URL=http://localhost:3001

# --- Backend (server/index.js) ---
# Anthropic key — kept server-side, never shipped to the browser.
REACT_APP_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Optional: backend port (defaults to 3001)
# PORT=3001
